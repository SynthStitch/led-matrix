# Panel flags for this sign, read by `sign` (the menu). setup.sh copies this to /opt/signtest/sign.conf.
# One or more flags per line; anything after # is ignored. Find your layout with panel-id (see CLAUDE.md).
#
# This is SynthStitch's frame: three rows of three P4 32x32 panels (96x96) on an Adafruit Triple LED Matrix
# Bonnet: top row on port 2, middle on port 1, bottom on port 3, all mounted upside down.
# Remap places each panel: one "x,y<turn>" per panel, port 1 first, starting at the panel nearest the Bonnet.
# Turns: n = as is, s = 180, e/w = 90. If the rows were simply ports 3, 2, 1 from the top, Rotate:180 would do.
--led-rows=32 --led-cols=32
--led-chain=3          # panels per port
--led-parallel=3       # ports in use; must reach the highest port with panels on it
--led-gpio-mapping=regular   # Triple Bonnet, Seengreat, Electrodragon. Single Adafruit HAT/Bonnet: adafruit-hat
--led-slowdown-gpio=4  # Pi 4. Raise it if the image has random pixels
--led-pixel-mapper=Remap:96,96|0,32s|32,32s|64,32s|0,0s|32,0s|64,0s|0,64s|32,64s|64,64s
